# ---------------------------------------------------------------------------
# Invoice LLM Extractor - copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Required: create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated list, tried in order. Models that do not exist are skipped.
GEMINI_MODELS=models/gemini-3.1-flash-lite,models/gemini-3.8-flash,models/gemini-flash-lite-latest,models/gemini-flash-latest

# Gemini request timeout (seconds) and retry policy.
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=1.5
GEMINI_RETRY_MAX_SECONDS=8
GEMINI_USE_RESPONSE_SCHEMA=true
GEMINI_MAX_OUTPUT_TOKENS=8192

# Upload limits.
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=10
MAX_PDF_PAGES=50
MAX_TEXT_CHARS=150000
UPLOAD_DIR=uploads
# Keep uploaded PDFs on disk after processing (false = delete them).
KEEP_UPLOADS=false
JOB_TTL_SECONDS=3600
MAX_JOBS=200
WORKER_THREADS=3

# OCR (Tesseract).
OCR_ENABLED=true
# Optional full path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_PSM=3
OCR_TIMEOUT_SECONDS=60
MIN_CHARS_PER_PAGE=40
MIN_OCR_CHARS=40

LOG_LEVEL=INFO
